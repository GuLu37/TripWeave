# =============================================================================
# LLM 配置
# =============================================================================
# 选择一个大模型供应商，并填写对应配置。
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=openai,proxy
LLM_MAX_RETRIES=3
# 仅在结构化契约或上游响应校验失败时输出模型原始响应；内容可能含对话数据，默认关闭。
LLM_DEBUG_LOG_RAW_OUTPUT=false
# 仅在结构化契约校验失败时输出 Agent 请求上下文与生成参数；默认关闭。
LLM_DEBUG_LOG_RAW_REQUEST=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# 第三方中转站（OpenAI 兼容接口）
PROXY_API_KEY=
PROXY_BASE_URL=
PROXY_MODEL=

# =============================================================================
# 外部工具 API
# =============================================================================
# 高德地图 Web 服务 API Key，仅供后端地点和路线查询使用。
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com

# 和风天气。填写控制台分配的专属 API Host 和服务端 API Key。
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# =============================================================================
# 应用运行配置
# =============================================================================
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
