# 复制为 backend/.env 后按需填写对应配置。

# =============================================================================
# LLM 配置
# =============================================================================
# 选择一个大模型供应商，并填写对应配置。
LLM_PROVIDER=deepseek
# 备用供应商按顺序填写；仅已配置的供应商会实际发起调用。
LLM_FALLBACK_PROVIDERS=openai,proxy
# 单个供应商在可恢复失败时的最大调用次数。
LLM_MAX_RETRIES=3
# 仅在结构化契约或上游响应校验失败时输出模型原始响应；内容可能含对话数据，默认关闭。
LLM_DEBUG_LOG_RAW_OUTPUT=false
# 仅在结构化契约校验失败时输出 Agent 请求上下文与生成参数；默认关闭。
LLM_DEBUG_LOG_RAW_REQUEST=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 审核总结 Agent 固定使用的 DeepSeek Pro 模型，可按账号已开通模型调整。
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# 第三方中转站（OpenAI 兼容接口）
PROXY_API_KEY=
PROXY_BASE_URL=
PROXY_MODEL=

# =============================================================================
# 外部工具 API
# =============================================================================
# 高德地图 Web 服务 API Key，仅供后端地点和路线查询使用。
AMAP_WEB_SERVICE_KEY=
# 保持官方服务域名；私有网关或测试环境可按需覆盖。
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com

# 和风天气。API Host 请从和风天气控制台-设置中复制专属地址，不要填写公共域名。
QWEATHER_API_HOST=
# API Key 仅在后端请求头中使用，禁止提交真实密钥或暴露给前端。
QWEATHER_API_KEY=

# LangGraph 会话检查点数据库，相对路径以 backend 目录为基准。
LANGGRAPH_CHECKPOINT_PATH=data/tripweave_checkpoints.sqlite

# =============================================================================
# 应用运行配置
# =============================================================================
# 允许访问后端的前端地址，多个地址用英文逗号分隔。
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志文件滚动配置，单位为字节。
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
